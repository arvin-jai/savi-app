# Local Supabase (npx supabase start prints these)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-me

# The service_role key must NEVER appear in an EXPO_PUBLIC_ var — anything
# prefixed EXPO_PUBLIC_ is bundled into the client and readable by anyone.

# ── Ask Savi (v0.4) ─────────────────────────────────────────────────────────
# The OpenAI key is deliberately ABSENT from this file. It is a server-side
# secret held by the Edge Function and must never reach the client: an Android
# APK is public, so a key in the bundle is a published key.
#
#   Local:  supabase/functions/.env   (gitignored)  →  OPENAI_API_KEY=sk-...
#           then: npx supabase functions serve
#   Hosted: npx supabase secrets set OPENAI_API_KEY=sk-...
#
# Optional: OPENAI_MODEL overrides the default (gpt-4o-mini). Tool calling is
# required, so any replacement must support it.
#
# See docs/AI-BOUNDARY.md §2.1.
